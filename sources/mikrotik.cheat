% mikrotik,routeros,ros7,firewall,ospf,ip,network,category:networking-cisco,pushou


; ============ FIREWALL ============

# désactiver tous les rules firewall
/ip firewall filter disable [find]
/ip firewall nat disable [find]
/ip firewall mangle disable [find]

# réactiver tous les rules firewall
/ip firewall filter enable [find]
/ip firewall nat enable [find]
/ip firewall mangle enable [find]

# voir les rules actives (non dynamiques)
/ip firewall filter print where dynamic=no

# voir les NAT rules
/ip firewall nat print

# masquerade (NAT sortant)
/ip firewall nat add chain=srcnat action=masquerade out-interface=<OUT_IFACE>

$ OUT_IFACE: echo $(/interface ethernet get [find] name)|parse regex "(?<=name=)([^,]+)"|tr '\n' ' '


; ============ IP ADDRESS ============

# ajouter une adresse IP
/ip address add address=<ADDRESS> interface=<INTERFACE>

# liste des adresses
/ip address print

# supprimer toutes les adresses
/ip address remove [find]

$ ADDRESS: echo '192.168.1.1/24 10.0.0.1/30 172.16.0.1/16' | tr ' ' '\n'
$ INTERFACE: echo $(/interface ethernet get [find] name)|parse regex "(?<=name=)([^,]+)"|tr '\n' ' '


; ============ ROUTING ============

# liste des routes
/ip route print

# route statique par défaut
/ip route add dst-address=0.0.0.0/0 gateway=<GATEWAY>

# route statique avec check
/ip route add dst-address=<NETWORK> gateway=<GATEWAY> check-gateway=ping

# route avec distance/priorité
/ip route add dst-address=<NETWORK> gateway=<GATEWAY> distance=<DIST>

# voir les routes actives
/ip route active print

$ GATEWAY: echo '192.168.1.254 10.0.0.1' | tr ' ' '\n'
$ NETWORK: echo '0.0.0.0/0 192.168.2.0/24 10.10.0.0/16' | tr ' ' '\n'
$ DIST: echo '1 10 255' | tr ' ' '\n'


; ============ OSPF (RouterOS 7) ============

# créer une instance OSPF
/routing ospf instance add name=<NAME> router-id=<ROUTER_ID> version=2

# désactiver l'instance
/routing ospf instance disable [find name=<NAME>]

# réactiver l'instance
/routing ospf instance enable [find name=<NAME>]

# créer une zone OSPF backbone
/routing ospf area add instance=<INSTANCE> name=backbone area-id=0.0.0.0

# template d'interface (broadcast pour Ethernet)
/routing ospf interface-template add area=backbone interfaces=<INTERFACES> auth=none network-type=broadcast

# redistribution des routes (connected + statiques)
/routing ospf instance set [find name=<NAME>] redistribute=connected,static

# re-négocier les voisins OSPF
/routing ospf neighbor remove [find]

# voir les voisins
/routing ospf neighbor print detail

# voir les routes OSPF
/routing ospf route print

$ NAME: echo 'ospf-main ospf-backbone ospf-red' | tr ' ' '\n'
$ ROUTER_ID: echo '1.1.1.1 10.0.0.1 192.168.1.1' | tr ' ' '\n'
$ INSTANCE: echo 'ospf-main ospf-backbone' | tr ' ' '\n'
$ INTERFACES: echo 'ether1,ether2,ether3 ether1 ether1,ether2,ether3,ether4,ether5,ether6' | tr ' ' '\n'


; ============ DHCP ============

# créer un pool DHCP
/ip dhcp-server add name=<DHCP_NAME> interface=<INTERFACE> address-pool=static address-pool-start=<START_IP>

# config réseau DHCP
/ip dhcp-server network add address=<NET> gateway=<GW> dns-address=<DNS>

$ DHCP_NAME: echo 'dhcp-lan dhcp-wan dhcp-guest' | tr ' ' '\n'
$ START_IP: echo '192.168.1.100 10.0.0.100 172.16.0.100' | tr ' ' '\n'
$ NET: echo '192.168.1.0/24 10.0.0.0/24 172.16.0.0/16' | tr ' ' '\n'
$ GW: echo '192.168.1.1 10.0.0.1 172.16.0.1' | tr ' ' '\n'
$ DNS: echo '8.8.8.8 1.1.1.1 192.168.1.1' | tr ' ' '\n'


; ============ SYSTEME / MAINTENANCE ============

# désactiver UPNP
/ip upnp set enabled=no

# désactiver le hotspot
/ip hotspot server disable [find]

# supprimer les bridge ports
/interface bridge port remove [find]

# voir les interfaces Ethernet
/interface ethernet print

# monitorer le trafic sur une interface
/interface monitor-traffic <INTERFACE>

# ressources système
/system resource print

# santé matérielle
/system health print

# identité du routeur
/system identity print

# logs en temps réel
/log print follow

# activer le debug OSPF
/system logging add topics=ospf,debug

$ INTERFACE: echo $(/interface ethernet get [find] name)|parse regex "(?<=name=)([^,]+)"|tr '\n' ' '


; ============ WIRELESS (si applicable) ============

# voir les interfaces wlan
/interface wireless print

# désassocier tous les clients
/interface wireless remove [find]

$ WLAN_IFACE: echo 'wlan1 wlan2' | tr ' ' '\n'
