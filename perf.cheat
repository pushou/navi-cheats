% iperf3, numa, pushou

# lscpu get NUMA (rg = apt install ripgrep)
lscpu|rg NUMA

# iperf3 cpu pinned
iperf3 --affinity 2 --client remotehost

# ipperf3 numactl 
numactl --physcpubind=2 iperf3 -c remotehost

# perf
perf stat -p <PID>


# bpftrace
bpftrace -e 'kprobe:vfs_read {@[comm]=count()}'

# dstat
dstart -cdngy 1

# pidstat
pidstat -u -d 1

# iotop
iotop -o

# slabtop
slabtop -s c

# numastat
numastat -p <PID>


